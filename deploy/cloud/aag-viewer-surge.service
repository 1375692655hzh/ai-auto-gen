[Unit]
Description=aag board x-surge collect (FxTwitter engagement + SoPilot RSS cache)
After=network-online.target aag-refresh.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python cli.py workbench refresh-x-surge --range 24h --limit 300
TimeoutStartSec=600
